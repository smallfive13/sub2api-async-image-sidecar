ASYNC_IMAGE_BIND_HOST=127.0.0.1
ASYNC_IMAGE_PORT=8090
ASYNC_IMAGE_WORKERS=2
ASYNC_IMAGE_MAX_QUEUE_SIZE=100
ASYNC_IMAGE_REQUEST_TIMEOUT_SECONDS=900
ASYNC_IMAGE_CALLBACK_TIMEOUT_SECONDS=15
ASYNC_IMAGE_MAX_BODY_BYTES=73400320
ASYNC_IMAGE_MAX_UPLOAD_BYTES=52428800
ASYNC_IMAGE_DEFAULT_GENERATION_MODEL=gpt-image-2.6-flare
ASYNC_IMAGE_DEFAULT_EDIT_MODEL=gpt-image-2.6-sunburst
ASYNC_IMAGE_TASK_RETENTION_SECONDS=86400
ASYNC_IMAGE_CLEANUP_INTERVAL_SECONDS=600
ASYNC_IMAGE_ALLOW_HTTP_CALLBACK=false
ASYNC_IMAGE_TOKEN_SECRET=replace-with-a-random-64-hex-value
ASYNC_IMAGE_CALLBACK_SECRET=
ASYNC_IMAGE_PUBLIC_BASE_URL=
SUB2API_BASE_URL=http://sub2api:8080
# Optional native OpenAI route. Keep secrets in server environment variables.
OPENAI_API_KEY=
# Comma-separated caller Sub2API API keys allowed to spend the server OpenAI credits.
ASYNC_IMAGE_OPENAI_ALLOWED_API_KEYS=
ASYNC_IMAGE_DEFAULT_SVG_MODEL=gpt-6.1-sol
SUB2API_DOCKER_NETWORK=sub2api_sub2api-net
ASYNC_IMAGE_IMAGE=sub2api-async-image-sidecar:local
